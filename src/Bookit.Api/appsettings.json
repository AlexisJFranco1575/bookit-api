{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "bookit-api",
    "Audience": "bookit-clients",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "BookingPermitLimit": 20
  },
  "Email": {
    "Mode": "Log",
    "Host": "",
    "Port": 587,
    "Security": "Auto",
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@bookit.local",
    "FromName": "Bookit",
    "TimeoutSeconds": 30
  },
  "Notifications": {
    "WorkerEnabled": true,
    "IntervalSeconds": 15,
    "BatchSize": 25
  }
}